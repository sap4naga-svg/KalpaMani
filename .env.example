# ===========================================================================
# KalpaMani - Example environment file
# ===========================================================================
# Copy to `.env` and fill in locally.  `.env` is git-ignored and MUST NEVER
# be committed.  This file contains VARIABLE NAMES AND PLACEHOLDERS ONLY.
#
# NEVER paste a real password, token, API key or 2FA secret into this file,
# into source control, into a log, or into an AI chat session.
# ===========================================================================

# --- Runtime environment ---------------------------------------------------
# One of: research | paper | live
# Default when unset is "research" (no brokerage, no orders).
# NOTE: selecting "live" does NOT authorize live trading. Live execution is
# hard-disabled in code and requires a separate, not-yet-implemented
# authorization gate plus explicit written approval.
KALPAMANI_ENV=research

# Human-readable deployment label used in logs/journals.
KALPAMANI_DEPLOYMENT_NAME=local-dev

# --- Strategy capital ------------------------------------------------------
# Capital ALLOCATED to KalpaMani strategies, in USD.
# This is deliberately NOT the broker account equity. A simulated IBKR paper
# balance (e.g. 1,000,000) must never become KalpaMani strategy capital.
KALPAMANI_STRATEGY_CAPITAL_USD=80000

# --- Broker: Interactive Brokers -------------------------------------------
# NOT USED YET. No brokerage connectivity exists in the codebase at bootstrap.
# Populate only when Phase 1 (IBKR PAPER connectivity) is explicitly approved.
# Host/port/client-id are non-secret connection parameters.
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1
# Paper account identifier, e.g. DUxxxxxxx  (NOT a credential, but keep local)
IBKR_PAPER_ACCOUNT_ID=DU0000000
# Credentials are supplied by the operator interactively or via a secrets
# manager. Do NOT store an IBKR password or 2FA seed here or anywhere in repo.
# IBKR_USERNAME=<supplied-via-secrets-manager>

# --- QuantConnect / LEAN ---------------------------------------------------
# Supplied via secrets manager or `lean login`. Placeholder names only.
QC_USER_ID=<quantconnect-user-id>
QC_API_TOKEN=<supplied-via-secrets-manager>

# --- Market data / fundamentals providers ----------------------------------
# Providers are TBD pending the Phase-0 point-in-time data audit.
MARKET_DATA_PROVIDER=<tbd>
MARKET_DATA_API_KEY=<supplied-via-secrets-manager>
EARNINGS_DATA_PROVIDER=<tbd>
EARNINGS_DATA_API_KEY=<supplied-via-secrets-manager>
BORROW_DATA_PROVIDER=<tbd>
BORROW_DATA_API_KEY=<supplied-via-secrets-manager>

# --- AI / LLM --------------------------------------------------------------
# Used by the Research and Challenger agents only (Phase 6). Never used to
# size positions, approve orders or override risk.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5
ANTHROPIC_API_KEY=<supplied-via-secrets-manager>

# --- Database (PostgreSQL, planned) ----------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=kalpamani
POSTGRES_USER=kalpamani
POSTGRES_PASSWORD=<supplied-via-secrets-manager>

# --- Monitoring / alerting -------------------------------------------------
ALERT_WEBHOOK_URL=<supplied-via-secrets-manager>
LOG_LEVEL=INFO
