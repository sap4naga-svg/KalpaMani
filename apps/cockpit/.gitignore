# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright review evidence and run artifacts. Screenshots are regenerated by
# `npm run test:e2e`; they are review evidence rather than a committed baseline.
/screenshots/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# The Next.js generator writes its own AGENTS.md/CLAUDE.md guidance files. Repository
# instructions live in the root CLAUDE.md and are reviewed there; an unreviewed
# instruction file must not enter this repository from a code generator.
/AGENTS.md
/CLAUDE.md

# C4 review evidence, regenerated by `npm run test:e2e`.
/screenshots-c4/

# C5 review evidence, regenerated by `npm run test:e2e`.
/screenshots-c5/

# C6 review evidence, regenerated by `npm run test:e2e`.
/screenshots-c6/

# ADR-0031 owning-area review evidence, regenerated by `npm run test:e2e`.
/screenshots-adr0031/

# C7 review evidence, regenerated by `npm run test:e2e`.
/screenshots-c7/

# C8 review evidence, regenerated by `npm run test:e2e`.
/screenshots-c8/
