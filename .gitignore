# ---------------------------------------------------------------------------
# KalpaMani .gitignore
# Security-first: credentials and broker/session artifacts must never be committed.
# ---------------------------------------------------------------------------

# --- Secrets / credentials -------------------------------------------------
.env
.env.*
!.env.example

*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.crt
*.cer
*.der

secrets/
credentials/
private/
.secrets/

# Common secret-file conventions
*secret*.json
*secrets*.yaml
*secrets*.yml
*credentials*.json
service-account*.json

# --- Broker / IBKR generated session + credential artifacts ----------------
# IB Gateway / TWS write session, settings and login state to disk.
ibgateway/
tws/
jts.ini
tws.xml
*.ibg
ib_session*
ibkr_session*
paper_session*
api_settings.xml

# --- QuantConnect / LEAN ---------------------------------------------------
lean/data/
lean/storage/
lean/backtests/
lean/live/
lean/optimizations/
# Root-level raw data drops only. Must NOT match src/kalpamani/data/.
/data/
.lean/
lean.json
!lean/config/lean.example.json

# LEAN CLI credential store
.lean/credentials

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/
.installed.cfg

.pytest_cache/
.mypy_cache/
.ruff_cache/
.dmypy.json
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/
.hypothesis/

.venv/
venv/
env/
ENV/
.python-version

# --- Logs / runtime --------------------------------------------------------
logs/*
!logs/.gitkeep
*.log
*.log.*

# --- Databases / local state ----------------------------------------------
*.db
*.sqlite
*.sqlite3
pgdata/

# --- Notebooks -------------------------------------------------------------
.ipynb_checkpoints/

# --- IDE / editor local (may contain tokens or local paths) ---------------
.vscode/
!.vscode/extensions.json
.idea/
*.iml
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Docker / local compose overrides -------------------------------------
docker-compose.override.yml
docker-compose.*.local.yml

# --- Scratch / research output --------------------------------------------
scratch/
tmp/
out/
research_output/

# --- Local-only runtime area (NEVER tracked) -------------------------------
# Holds generated LEAN runtime configuration, brokerage credentials persisted by
# LEAN, tool virtualenvs and run logs. Nothing under .runtime/ may ever be
# committed. Verified with `git check-ignore .runtime`.
.runtime/

# --- Phase 3 data platform (NEVER tracked) --------------------------------
# The point-in-time data platform writes only under .runtime/, which is already
# ignored above. These entries are explicit rather than inherited, because a
# vendor payload committed to a PUBLIC repository is both a licence breach and,
# as INC-0002 established, not undone by a force-push.
#
# Repository-owned SYNTHETIC fixtures under tests/ are deliberately NOT matched:
# they are legible, hand-authored, fictitious, and must stay reviewable.
.runtime/data/
*.duckdb
*.duckdb.wal
*.duckdb.tmp/
.runtime/**/*.parquet
.runtime/**/*.jsonl
.runtime/**/*.json.gz

# --- Original blueprint source drop ---------------------------------------
# The authoritative copy is committed at docs/architecture/KalpaMani_Blueprint_V2_1.pdf
# and is byte-identical (verified by SHA-256). The original drop is preserved on
# disk but not committed, to avoid a duplicate binary blob in history.
/AI_Swing_Momentum_Trading_System_Blueprint_V2_1*.pdf
